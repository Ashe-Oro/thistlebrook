{
  "name": "thistlebrook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "catalog:bounds": "node tools/compute-bounds.mjs",
    "inspect:glb": "node tools/inspect-glb.mjs",
    "compile": "node tools/compile.mjs",
    "shots": "node tools/shots.mjs",
    "shots:post": "node tools/shots.mjs --post",
    "test:checks": "node tools/check-negatives.mjs && node tools/check-batches.mjs && node tools/check-medium.mjs",
    "test:parity": "node tools/parity.mjs",
    "test:world-registry": "node --test tests/world-registry.test.mjs",
    "shots:village-m1": "node tools/shots-village-m1.mjs",
    "shots:village-m2": "node tools/shots-village-m2.mjs",
    "shots:village-art": "node tools/shots-village-art.mjs",
    "shots:village-m3": "node tools/shots-village-m3.mjs",
    "shots:village-buildings": "node tools/shots-village-buildings.mjs",
    "shots:village-light": "node tools/shots-village-light.mjs",
    "test:medium": "node tools/check-medium.mjs",
    "shots:village-medium": "node tools/shots-village-medium.mjs",
    "shots:village-life": "node tools/shots-village-life.mjs",
    "test:life-routines": "node --test tools/life-routines.test.mjs",
    "shots:village-props": "node tools/shots-village-props.mjs",
    "shots:village-iso": "node tools/shots-village-iso.mjs",
    "// WORKTREE-HOOK life-routines": "local evidence and tests",
    "compile:astra": "node tools/compile-astra.mjs",
    "test:astra": "node --test tests/astra*.test.mjs tests/sunbeam.test.mjs tests/skatepark.test.mjs",
    "shots:astra": "node tools/shots-astra.mjs",
    "shots:astra:expansion": "node tools/shots-astra-expansion.mjs",
    "film:astra:expansion": "node tools/film-astra.mjs --expansion",
    "shots:astra:work": "node tools/shots-astra-work.mjs",
    "shots:astra:merged": "node tools/shots-astra-merged.mjs",
    "film:astra:merged": "node tools/film-astra-merged.mjs",
    "catalog:inventory": "node tools/inventory-library.mjs",
    "test:astra:integration": "node tools/verify-astra-round2.mjs",
    "shots:astra:round2": "node tools/capture-astra-round2.mjs",
    "film:astra:round2": "node tools/film-astra-round2.mjs",
    "test:astra:registry": "node --test tests/astra-registry.test.mjs",
    "inventory:astra:registry": "node tools/inventory-astra-registry.mjs",
    "test:astra:round3": "node tools/verify-astra-round3.mjs",
    "shots:astra:round3": "node tools/capture-astra-round3.mjs",
    "film:astra:round3": "node tools/film-astra-round3.mjs",
    "test:astra:registry:expansions": "node --test tests/astra-registry-expansions.test.mjs",
    "test:astra:registry:browser": "node tools/verify-registry-expansions.mjs",
    "capture:astra:registry": "node tools/capture-registry-models.mjs",
    "deploy:dist": "node tools/prepare-deploy-dist.mjs",
    "test:grok-roads": "node --test tests/grok-roads.test.mjs tests/grok-roads-sim.test.mjs",
    "audit:roads": "node tools/audit-roads.mjs",
    "sim:collisions": "node tools/sim-collisions.mjs",
    "test:river": "node --test tests/astra-river.test.mjs",
    "shots:river": "node tools/shots-grok-river.mjs",
    "test:grok-fairlot": "node --test tests/grok-fairlot.test.mjs",
    "map:river": "node tools/river-map.mjs",
    "models:upload": "node tools/upload-licensed-models.mjs",
    "models:fetch": "node tools/fetch-licensed-models.mjs",
    "test:ci": "node --test tests/*.mjs tools/life-routines.test.mjs && npm run test:checks",
    "test:woods": "node --test tests/grok-woods.test.mjs",
    "shots:woods": "node tools/shots-grok-woods.mjs",
    "film:woods": "node tools/film-grok-woods.mjs"
  },
  "// WORKTREE-HOOK medium": "Adds test:medium and shots:village-medium; extends test:checks additively.",
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@vercel/blob": "^2.9.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.65.0",
    "vite": "^5.4.0"
  }
}
